# Copy to .env (never commit real keys)
LLM_PROVIDER=echo
# LLM_PROVIDER=gemini  + GEMINI_API_KEY=...  + GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# LLM_PROVIDER=openai-compat + OPENAI_API_KEY + optional OPENAI_BASE_URL/OPENAI_MODEL
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MAX_CHUNKS=5
PORT=8000
# Security / demo knobs (no secrets)
FRONTEND_ORIGIN=
ALLOWED_ORIGINS=
MAX_DOC_IDS=5
MAX_STORE_CHUNKS=5000
RATE_LIMIT_PER_MIN=200
DEMO_MODE=true
